generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  name             String?
  email            String         @unique
  passwordHash     String

  lemonCustomerId  String?        @unique

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  projects         Project[]
  subscription     Subscription?
}

model Project {
  id          String   @id @default(cuid())

  userId      String
  user        User     @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  name        String

  /*
   * SIX EDITABLE BOX FACES
   */

  frontImage  String?  @db.Text
  backImage   String?  @db.Text

  rightImage  String?  @db.Text
  leftImage   String?  @db.Text

  topImage    String?  @db.Text
  bottomImage String?  @db.Text

  /*
   * EDITOR SETTINGS
   */

  background  String   @default("#eef2ff")

  rotationX   Float    @default(-0.15)
  rotationY   Float    @default(0.65)
  rotationZ   Float    @default(0)

  scale       Float    @default(1)

  /*
   * TIMESTAMPS
   */

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /*
   * INDEX
   */

  @@index([userId, updatedAt])
}

model Subscription {
  id                  String   @id @default(cuid())

  userId              String   @unique

  user                User     @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  /*
   * LEMON SQUEEZY
   */

  lemonSubscriptionId String   @unique
  lemonCustomerId     String?

  variantId           String
  plan                String
  status              String

  /*
   * BILLING DATES
   */

  renewsAt            DateTime?
  endsAt              DateTime?

  currentPeriodStart  DateTime @default(now())

  /*
   * DOWNLOAD USAGE
   *
   * Starter = 10
   * Creator = 20
   * Studio = unlimited
   */

  downloadsUsed      Int      @default(0)

  /*
   * TIMESTAMPS
   */

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  /*
   * INDEXES
   */

  @@index([status, variantId])
}